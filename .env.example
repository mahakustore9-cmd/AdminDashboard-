# Environment Configuration

# 1. Supabase Project Configuration
# Get these values from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Application URL
# Used for login links and WhatsApp invitation templates
VITE_APP_URL="http://localhost:3000"

# Note: Never put your Supabase service_role key here.
# The service_role key must only be placed in Supabase Edge Functions Secrets!
